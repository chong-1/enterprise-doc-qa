# ========== 应用配置 ==========
APP_NAME=EnterpriseQA
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key
API_PREFIX=/api/v1

# ========== MySQL ==========
# 本地 Docker 部署填 localhost；若部署在云服务器，填公网 IP，如 118.178.93.114
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=eqa_user
MYSQL_PASSWORD=eqa_password_2024
MYSQL_DATABASE=enterprise_qa
MYSQL_ROOT_PASSWORD=root_password_2024
MYSQL_POOL_SIZE=20
MYSQL_POOL_RECYCLE=3600

# ========== Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========== MinIO (可选) ==========
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_SECURE=false

# 若不用 MinIO，文件存本地
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=./data/uploads

# ========== Chroma ==========
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_PREFIX=kb_

# ========== BGE-M3 Embedding ==========
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true

# ========== Reranker ==========
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_TOP_K=5

# ========== LLM 配置 ==========
# 可选 ollama 或 openai
LLM_BACKEND=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# Ollama 本地模式：
# LLM_BACKEND=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:14b

# ========== JWT ==========
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== Celery ==========
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ========== 分块配置 ==========
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ========== 限流 ==========
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_DAY=1000

# ========== CORS ==========
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
